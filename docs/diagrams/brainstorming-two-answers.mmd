---
config:
  theme: base
  fontFamily: "Arial, Helvetica, sans-serif"
  sequence:
    actorMargin: 50
    width: 130
    diagramMarginX: 10
    boxMargin: 12
    boxTextMargin: 8
    messageMargin: 40
    noteMargin: 22
    labelBoxWidth: 56
    labelBoxHeight: 28
    messageFontSize: 16
    actorFontSize: 16
    noteFontSize: 15
    wrap: false
  themeVariables:
    textColor: "#8b5cf6"
    actorBkg: "#ede9fe"
    actorBorder: "#7c3aed"
    actorTextColor: "#4c1d95"
    actorLineColor: "#a78bfa"
    signalColor: "#8b949e"
    signalTextColor: "#6e7781"
    labelBoxBkgColor: "#ccfbf1"
    labelBoxBorderColor: "#0d9488"
    labelTextColor: "#134e4a"
    loopTextColor: "#0d9488"
    noteBkgColor: "#fef3c7"
    noteBorderColor: "#d97706"
    noteTextColor: "#78350f"
    activationBkgColor: "#c4b5fd"
    activationBorderColor: "#7c3aed"
    mainBkg: "#ede9fe"
    nodeBorder: "#7c3aed"
    secondaryColor: "#ede9fe"
    secondaryBorderColor: "#7c3aed"
    secondaryTextColor: "#4c1d95"
    tertiaryColor: "#ede9fe"
    tertiaryBorderColor: "#7c3aed"
    tertiaryTextColor: "#4c1d95"
  themeCSS: >
    svg, .label, .nodeLabel, .edgeLabel, foreignObject div { font-family: Arial, Helvetica, sans-serif; }
    .actor { filter: drop-shadow(0 3px 6px rgba(15, 23, 42, 0.18)); }
    rect.actor { rx: 12px; ry: 12px; }
---
sequenceDiagram
    participant Driver as DefaultDriver
    participant MCU as Nano firmware
    participant ISR as Timer1 ISR

    Driver ->> MCU: ShootCommand, seq 7
    Note over MCU: validate the table
    MCU ->> ISR: start
    MCU -->> Driver: ShotResponse, seq 7, duration
    Note over Driver: no request while waiting
    Note over ISR: last step ends
    ISR ->> MCU: done
    MCU -->> Driver: ShotFinished, seq 7, timings
    alt nothing within<br/>duration plus margin
        Driver ->> MCU: ShotStatusQuery
        MCU -->> Driver: done, seq 7, timings
    end
