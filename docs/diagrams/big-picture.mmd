---
config:
  theme: base
  fontFamily: "Arial, Helvetica, sans-serif"
  flowchart:
    curve: basis
    padding: 12
    nodeSpacing: 46
    rankSpacing: 32
    subGraphTitleMargin:
      top: 4
      bottom: 10
  class:
    padding: 10
  themeVariables:
    lineColor: "#94a3b8"
    textColor: "#64748b"
    primaryColor: "#f1f5f9"
    primaryBorderColor: "#64748b"
    primaryTextColor: "#0f172a"
    secondaryColor: "#f1f5f9"
    secondaryBorderColor: "#64748b"
    secondaryTextColor: "#0f172a"
    tertiaryColor: "#f1f5f9"
    tertiaryBorderColor: "#64748b"
    tertiaryTextColor: "#0f172a"
    mainBkg: "#f1f5f9"
    nodeBorder: "#64748b"
    nodeTextColor: "#0f172a"
    classText: "#0f172a"
    clusterBkg: "transparent"
    clusterBorder: "#94a3b8"
    titleColor: "#64748b"
    edgeLabelBackground: "#ffffff"
  themeCSS: >
    svg, .label, .nodeLabel, .edgeLabel, foreignObject div { font-family: Arial, Helvetica, sans-serif; }
    .node rect, .node polygon, .node path {
      filter: drop-shadow(0 3px 6px rgba(15, 23, 42, 0.18));
    }
    .node rect { rx: 14px; ry: 14px; }
    .cluster rect { rx: 18px; ry: 18px; }
    .edgeLabel, .edgeLabel p, .edgeLabel span {
      background: #ffffff; color: #475569; border-radius: 999px;
    }
    .edgeLabel p { padding: 3px 10px; }
    .labelBkg { background: transparent !important; fill: none !important; }
---
flowchart TB
    Client(["<b>Clients</b><br/>a focus stacking sequence,<br/>ros2 CLI"])
    Page(["<b>Board page</b><br/>in a browser"])
    Bridge("<b>rosbridge</b><br/>port 9092")

    subgraph Host["HOST"]
        Node{{"<b>FreezerNode</b>"}}
        Runner("<b>ShotRunner</b><br/>its own thread")
        Sync("<b>SynchronizedDriver</b>")
        Default("<b>DefaultDriver</b>")
    end

    subgraph Board["FREEZER BOARD#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;#nbsp;"]
        Trigger("<b>IN1</b>")
        Nano("<b>Arduino Nano R4</b><br/>a timer walks the table")
        Registers("<b>2 x 74HC595</b><br/>16 outputs")
        Opto("<b>16 optocouplers</b>")
    end

    Jacks("<b>OUT1 to OUT8</b>")
    Devices("<b>cameras, flashes, lights</b><br/>powered externally")
    Button(["<b>Remote trigger</b>"])

    Client <-- "Shoot action<br/>set_outputs, stop" --> Node
    Page <-. "WebSocket, JSON" .-> Bridge
    Bridge <-. "shots<br/>the commands" .-> Node
    Node --> Runner
    Node --> Sync
    Runner --> Sync
    Sync --> Default
    Nano <=====>|"USB serial<br/>framed, CRC-16"| Default
    Nano == "shift, latch" ==> Registers
    Registers ==> Opto
    Trigger --> Nano
    Opto ==> Jacks
    Jacks ==> Devices
    Button --> Trigger

    classDef human fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#881337
    classDef voice fill:#ccfbf1,stroke:#0d9488,stroke-width:2px,color:#134e4a
    classDef mind  fill:#ede9fe,stroke:#7c3aed,stroke-width:2px,color:#4c1d95
    classDef brain fill:#7c3aed,stroke:#5b21b6,stroke-width:2px,color:#ffffff
    classDef robot fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#78350f
    classDef data  fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#1e3a8a
    classDef ext   fill:#f1f5f9,stroke:#64748b,stroke-width:2px,color:#0f172a

    class Client,Page,Button human
    class Bridge voice
    class Node brain
    class Runner,Sync,Default mind
    class Trigger,Nano,Registers,Opto,Jacks robot
    class Devices ext

    style Host fill:#8b5cf612,stroke:#8b5cf6,stroke-width:1.5px,stroke-dasharray:6 5,color:#7c3aed
    style Board fill:#f59e0b12,stroke:#f59e0b,stroke-width:1.5px,stroke-dasharray:6 5,color:#d97706

    linkStyle 0 stroke:#f43f5e,stroke-width:2px
    linkStyle 1,2 stroke:#14b8a6,stroke-width:2px
    linkStyle 3,4,5,6 stroke:#8b5cf6,stroke-width:2px
    linkStyle 7,8,9,11,12 stroke:#f59e0b,stroke-width:3px
    linkStyle 10,13 stroke:#f43f5e,stroke-width:2px
