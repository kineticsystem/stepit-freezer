---
config:
  theme: base
  fontFamily: "Arial, Helvetica, sans-serif"
  sequence:
    actorMargin: 50
    width: 130
    diagramMarginX: 10
    boxMargin: 12
    boxTextMargin: 8
    messageMargin: 40
    noteMargin: 22
    labelBoxWidth: 56
    labelBoxHeight: 28
    messageFontSize: 16
    actorFontSize: 16
    noteFontSize: 15
    wrap: false
  themeVariables:
    textColor: "#8b5cf6"
    actorBkg: "#ede9fe"
    actorBorder: "#7c3aed"
    actorTextColor: "#4c1d95"
    actorLineColor: "#a78bfa"
    signalColor: "#8b949e"
    signalTextColor: "#6e7781"
    labelBoxBkgColor: "#ccfbf1"
    labelBoxBorderColor: "#0d9488"
    labelTextColor: "#134e4a"
    loopTextColor: "#0d9488"
    noteBkgColor: "#fef3c7"
    noteBorderColor: "#d97706"
    noteTextColor: "#78350f"
    activationBkgColor: "#c4b5fd"
    activationBorderColor: "#7c3aed"
    mainBkg: "#ede9fe"
    nodeBorder: "#7c3aed"
    secondaryColor: "#ede9fe"
    secondaryBorderColor: "#7c3aed"
    secondaryTextColor: "#4c1d95"
    tertiaryColor: "#ede9fe"
    tertiaryBorderColor: "#7c3aed"
    tertiaryTextColor: "#4c1d95"
  themeCSS: >
    svg, .label, .nodeLabel, .edgeLabel, foreignObject div { font-family: Arial, Helvetica, sans-serif; }
    .actor { filter: drop-shadow(0 3px 6px rgba(15, 23, 42, 0.18)); }
    rect.actor { rx: 12px; ry: 12px; }
---
sequenceDiagram
    participant Client
    participant Node as FreezerNode
    participant MCU as Nano firmware

    Client ->> Node: goal, sequence flash_shot
    Note over Node: build the table, check the limits
    Node -->> Client: accepted
    Node -->> Client: feedback LOADING
    opt another table<br/>is loaded
        Node ->> MCU: LoadSequence
        MCU -->> Node: duration
    end
    Node ->> MCU: Shoot
    MCU -->> Node: shot id, duration
    Node -->> Client: feedback RUNNING, shot id
    loop every 10 ms
        Node ->> MCU: Status
        MCU -->> Node: running or idle
    end
    Node -->> Client: result, timings
